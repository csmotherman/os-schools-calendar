# Supabase values from the project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application origin used for auth redirect URLs.
# Local: http://localhost:3000
# Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Do not add a service-role key unless a later server-only feature truly requires it.
# The current application foundation intentionally relies on user sessions + RLS.
