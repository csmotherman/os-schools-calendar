{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-dist",
    "noEmit": false,
    "declaration": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "lib/calendar/generate.ts",
    "lib/calendar/summary.ts",
    "types/database.ts",
    "tests/**/*.ts"
  ]
}
